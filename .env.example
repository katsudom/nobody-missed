# Names only. Copy to bridge/.env (bridge) and .env.local (web). Never commit real values.

# --- web board (Vite) ---
VITE_SPACETIMEDB_HOST=ws://localhost:3000
VITE_SPACETIMEDB_DB_NAME=
# Public (pk.) token from account.mapbox.com/access-tokens. It ships in the browser bundle: restrict it to our URLs.
VITE_MAPBOX_TOKEN=
# Optional: state code(s) for National Weather Service warnings, comma separated. Defaults to TX.
VITE_WEATHER_AREA=TX

# --- bridge (bridge/.env) ---
SPACETIMEDB_HOST=ws://localhost:3000
SPACETIMEDB_DB_NAME=
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
DEMO=true
