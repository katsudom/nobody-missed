{
  "name": "nobody-missed",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "vite --mode sandbox",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "spacetime:dev": "spacetime dev --server local",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "spacetime:publish:local": "spacetime publish --module-path spacetimedb --server local",
    "spacetime:publish": "spacetime publish nobody-missed --module-path spacetimedb --server maincloud",
    "sandbox:publish": "spacetime publish nobody-missed --module-path spacetimedb --server local --delete-data=on-conflict --yes && spacetime call nobody-missed open_sandbox --server local"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "spacetimedb": "2.14.*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.6.2",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
